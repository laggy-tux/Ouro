<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Redpanda" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Redpanda.App</item>
    </style>

    <style name="Theme.Redpanda.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
